# Migration SQL schema is source-controlled; operational import/rollback files
# and spreadsheet/CSV data remain ignored.
/migration/*
!/migration/
!/migration/*.sql
# Skrip audit storage (report-only, tanpa secret).
!/migration/audit_storage.py
# Skrip backfill URL storage (idempoten, tanpa secret).
!/migration/backfill_r2_urls.py

# RLS backup dumps (local only, contains database data)
/backup-rls/
backup-rls/

# Kredensial akun tes E2E staging (lokal saja, BERISI PASSWORD - jangan di-commit).
/LOGIN.md

# Test artifacts (local only), except source-controlled verification scripts.
/tests/*
!/tests/
!/tests/verify_product_attachments.py
!/tests/verify_po_analytics_detail.py
# Unit test murni migrasi storage (tanpa secret/koneksi).
!/tests/test_parse_storage_url.py
!/tests/test_object_store_r2.py
# E2E upload UI -> R2 staging (tanpa secret; kredensial via env vars saat dijalankan).
!/tests/e2e_upload_staging.py
# E2E request_id activity log (UI /notes -> activity_logs staging; kredensial via env vars).
!/tests/e2e_activity_request_id.py
# E2E smoke pasca-refactor route (halaman GET + alur sample/brand; kredensial via env vars).
!/tests/e2e_smoke_refactor.py
# Unit tests security (pure logic, tanpa koneksi/secret).
!/tests/test_security_helpers.py
!/tests/test_upload_validation.py
!/tests/test_auth_matrix.py
# Regression test temuan audit codebase 2026-10-21 (pure logic, tanpa koneksi/secret).
!/tests/test_audit_regressions.py
# Verifikasi state database staging read-only untuk temuan audit 2026-10-21.
!/tests/verify_audit_db_state.py
# E2E Playwright temuan audit 2026-10-21 (staging saja; kredensial via env vars).
!/tests/e2e_audit_staging.py

# Log konsol staging lokal & artefak E2E (runtime, jangan di-commit).
/staging.log
/_e2e_upload_tmp.pdf
/_e2e_smoke_tmp.pdf

# Contoh surat pengantar pengujian air (dokumen lokal, jangan di-commit).
/excel-example/air/

# One-off refactor helper scripts
scripts/refactor/

